# Local-only Nacos identity values. Replace them before enabling client authentication.
NACOS_AUTH_TOKEN=c3ByaW5nLXByb2plY3QtbmFjb3MtbG9jYWwtZGV2LXRva2VuLXNlY3JldC0yMDI2
NACOS_AUTH_IDENTITY_KEY=hard-nacos-local-key
NACOS_AUTH_IDENTITY_VALUE=hard-nacos-local-value

# Used by bootstrap.sh to initialize the local console administrator.
# Keep the real value in the ignored infra/nacos/.env file.
NACOS_ADMIN_PASSWORD=replace-with-a-strong-local-password

# Keep the standalone learning instance small enough for local development.
NACOS_JVM_XMS=256m
NACOS_JVM_XMX=512m
NACOS_JVM_XMN=128m
